<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.myApp.demos.mapper.UserMapper">

    <insert id="addUser">
        insert into t_user(user_id ,name ,password ,email ,salt ,phone ,create_time) values (#{user.userId} ,#{user.name} ,#{user.password} ,#{user.email} ,#{user.salt} ,#{user.phone} ,now())
    </insert>

    <insert id="subscribeMsg">
        insert into t_user_group (user_id ,group_id) values
        <foreach collection="list" item="t" separator="," index="index">
            (#{t.userId}, #{t.groupId})
        </foreach>
    </insert>

    <update id="updateAvatar">
        update t_user set head_pic_url =#{param1} where user_id =#{param2}
    </update>

    <select id="findUser" resultType="com.example.myApp.demos.entity.User">
        select * from t_user where name =#{name} and status =0
    </select>

    <select id="queryNames" resultType="java.lang.String">
        select name from t_user
    </select>

</mapper>