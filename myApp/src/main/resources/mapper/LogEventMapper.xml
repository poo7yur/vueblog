<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.myApp.demos.mapper.LogEventMapper">
    <insert id="saveLogEvent">
        insert into log_event(message ,level ,timestp) values (#{event.message} ,#{event.level} ,#{event.timestp})
    </insert>

    <insert id="saveAccessLog">
        insert into t_log(module ,description ,ip ,login_user ,uri ,method ,params ,result ,access_time) values
        (#{log.module} ,#{log.description} ,#{log.ip} ,#{log.loginUser} ,#{log.uri} ,#{log.method} ,#{log.params} ,#{log.result} ,#{log.accessTime})
    </insert>

</mapper>